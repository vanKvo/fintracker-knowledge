# KN-FAPI-07: copy to .env.local (git-ignored) and replace every value. Local use only.
# The values must match the shared PostgreSQL container (infrastructure/local-postgres/.env): the admin password is its
# POSTGRES_PASSWORD, and the login-role passwords are the same KNOWLEDGE_DB_*_PASSWORD values, because the container
# creates the roles with them on its first start.

# Administrative user: runs the migrations and never given to the app. The container's `postgres` superuser.
KNOWLEDGE_DB_ADMIN_USER=postgres
KNOWLEDGE_DB_ADMIN_PASSWORD=mysecretpassword
FLYWAY_USER=postgres
FLYWAY_PASSWORD=mysecretpassword

# Login roles the app connects as. Not superusers, no BYPASSRLS: Row-Level Security applies to them.
KNOWLEDGE_DB_RETRIEVE_PASSWORD=change-me-retrieve
KNOWLEDGE_DB_INGEST_PASSWORD=change-me-ingest
